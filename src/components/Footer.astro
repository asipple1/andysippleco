---
// Footer with logo stems, nav links, coordinates
---

<footer class="footer">
  <div class="grid gap-8 items-end" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))">

    <!-- Brand -->
    <div data-footer-brand="" class="relative grid gap-1.5 pl-[54px]">
      <!-- Stem marks (decorative lines extending from spine into footer) -->
      <svg
        data-footer-mark=""
        aria-hidden="true"
        viewBox="0 0 56 56"
        preserveAspectRatio="xMinYMax meet"
        class="footer-mark"
        fill="none"
        stroke-width="5"
        stroke-linecap="butt"
      >
        <path d="M4 -400 L4 36 Q4 50 18 50 L52 50" stroke="#EB3323"/>
        <path d="M14 -400 L14 30 Q14 40 24 40 L52 40" stroke="#F3C623"/>
        <path d="M24 -400 L24 24 Q24 30 30 30 L52 30" stroke="#19A6A3"/>
        <path d="M34 -400 L34 18 Q34 20 36 20 L52 20" stroke="#541B36"/>
      </svg>
      <div class="font-heading font-extrabold text-[28px] tracking-[.04em] uppercase">Andy Sipple</div>
      <div class="text-[14px]">Senior Web Developer<br>Oʻahu, Hawaiʻi</div>
    </div>

    <!-- Social links -->
    <div class="flex gap-6 text-[14px] font-medium">
      <a href="https://linkedin.com/in/andysipple" target="_blank" rel="noopener noreferrer"
        class="text-cream no-underline border-b border-teal hover:text-yellow">LinkedIn</a>
      <a href="https://github.com/andysipple" target="_blank" rel="noopener noreferrer"
        class="text-cream no-underline border-b border-teal hover:text-yellow">GitHub</a>
      <a href="mailto:hello@andysipple.com"
        class="text-cream no-underline border-b border-teal hover:text-yellow">Email</a>
    </div>

    <!-- Coordinates -->
    <div
      data-footer-right=""
      class="font-mono text-[12px] tracking-[.18em] uppercase text-teal-text justify-self-end text-right"
    >
      Transmitting from the Pacific · Est. 2026
    </div>
  </div>
</footer>

<style>
.footer {
  position: relative;
  z-index: 12;
  background: #06060F;
  color: #F1E3CB;
  padding: clamp(40px,5vw,64px) clamp(20px,5vw,64px);
  border-top: 1px solid rgba(241,227,203,.18);
}

.footer-mark {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 40px;
  height: calc(clamp(40px,5vw,64px) + 41px);
  overflow: hidden;
}
</style>
