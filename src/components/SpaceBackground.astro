---
// Parallax space background - stars, planets, fixed behind everything
---

<div
  aria-hidden="true"
  class="space-bg"
>
  <!-- Far stars -->
  <svg
    data-parallax="0.05"
    class="stars-layer"
    preserveAspectRatio="xMidYMin slice"
    viewBox="0 0 100 1400"
  >
    <g id="stars-far"></g>
  </svg>

  <!-- Near stars -->
  <svg
    data-parallax="0.14"
    class="stars-layer"
    preserveAspectRatio="xMidYMin slice"
    viewBox="0 0 100 1400"
  >
    <g id="stars-near"></g>
  </svg>

  <!-- Saturn · hero -->
  <svg
    data-saturn=""
    data-parallax="0.35"
    viewBox="0 0 1600 1600"
    class="planet-saturn"
  >
    <g transform="translate(300 300)">
      <defs>
        <clipPath id="satClip"><circle cx="500" cy="500" r="330"/></clipPath>
        <clipPath id="satBack"><rect x="-400" y="-400" width="1800" height="900"/></clipPath>
        <clipPath id="satFront"><rect x="-400" y="500" width="1800" height="900"/></clipPath>
        <clipPath id="satBackClip"><rect x="-600" y="-700" width="2200" height="1200"/></clipPath>
        <clipPath id="satFrontClip"><rect x="-600" y="500" width="2200" height="1200"/></clipPath>
        <radialGradient id="moonShade" cx="35%" cy="30%" r="80%">
          <stop offset="0" stop-color="#0B0A1E" stop-opacity="0"/>
          <stop offset=".7" stop-color="#0B0A1E" stop-opacity=".1"/>
          <stop offset="1" stop-color="#0B0A1E" stop-opacity=".8"/>
        </radialGradient>
      </defs>

      <!-- Glow -->
      <circle cx="500" cy="500" r="400" fill="#EF7D22" opacity=".12" class="blur-44"/>

      <!-- Rings back -->
      <g transform="rotate(-14 500 500)">
        <g clip-path="url(#satBack)" fill="none">
          <ellipse cx="500" cy="500" rx="720" ry="144" stroke="#EB3323" stroke-width="4" pathLength="1" stroke-dasharray=".22 .03 .4 .03 .25 .07" class="ring-red"/>
          <ellipse cx="500" cy="500" rx="670" ry="132" stroke="#F3C623" stroke-width="4" pathLength="1" stroke-dasharray=".35 .04 .3 .04 .27" class="ring-yellow"/>
          <ellipse cx="500" cy="500" rx="620" ry="120" stroke="#19A6A3" stroke-width="4" pathLength="1" stroke-dasharray=".5 .05 .4 .05" class="ring-teal"/>
          <ellipse cx="500" cy="500" rx="570" ry="108" stroke="#8A2E57" stroke-width="4" pathLength="1" stroke-dasharray=".6 .03 .34 .03" class="ring-plum"/>
          <ellipse cx="500" cy="500" rx="780" ry="156" stroke="#F1E3CB" stroke-width="1.5" pathLength="1" stroke-dasharray=".004 .008" opacity=".5" class="ring-cream"/>
        </g>
      </g>

      <!-- Moon back (orbits behind) -->
      <g transform="rotate(-14 500 500)">
        <defs><clipPath id="moonBackClip"><rect x="-400" y="-400" width="1800" height="900"/></clipPath></defs>
        <g clip-path="url(#moonBackClip)">
          <g>
            <circle cx="0" cy="0" r="26" fill="#E2D3B6"/>
            <circle cx="-8" cy="-6" r="7" fill="#9A8A6A" opacity=".7"/>
            <circle cx="9" cy="8" r="4.5" fill="#9A8A6A" opacity=".7"/>
            <circle cx="6" cy="-11" r="3" fill="#9A8A6A" opacity=".6"/>
            <circle cx="0" cy="0" r="26" fill="url(#moonShade)"/>
            <animateMotion dur="90s" begin="-20s" repeatCount="indefinite"
              path="M 1280 500 A 780 156 0 1 1 -280 500 A 780 156 0 1 1 1280 500"/>
          </g>
        </g>
      </g>

      <!-- Globe -->
      <circle cx="500" cy="500" r="330" fill="#F3B04A"/>
      <g clip-path="url(#satClip)" transform="rotate(-14 500 500)">
        <rect x="0" y="170" width="1000" height="60" fill="#FFE3A6"/>
        <rect x="0" y="230" width="1000" height="36" fill="#EF7D22"/>
        <rect x="0" y="300" width="1000" height="22" fill="#C4561E"/>
        <rect x="0" y="360" width="1000" height="70" fill="#EF7D22"/>
        <rect x="0" y="430" width="1000" height="14" fill="#FFE3A6"/>
        <rect x="0" y="480" width="1000" height="90" fill="#C4561E"/>
        <rect x="0" y="570" width="1000" height="20" fill="#FFE3A6"/>
        <rect x="0" y="620" width="1000" height="50" fill="#EF7D22"/>
        <rect x="0" y="700" width="1000" height="30" fill="#8A3214"/>
        <rect x="0" y="760" width="1000" height="80" fill="#541B36"/>
        <!-- Storm oval -->
        <ellipse cx="610" cy="520" rx="70" ry="26" fill="#FFE3A6"/>
        <ellipse cx="610" cy="520" rx="44" ry="14" fill="#EB3323"/>
        <!-- Ring shadow -->
        <ellipse cx="500" cy="500" rx="660" ry="128" fill="none" stroke="#0B0A1E" stroke-width="150" opacity=".38" transform="translate(0,-88)"/>
        <!-- Terminator -->
        <circle cx="640" cy="560" r="330" fill="#0B0A1E" opacity=".55"/>
      </g>
      <circle cx="500" cy="500" r="330" fill="none" stroke="#FFE3A6" stroke-width="3"/>

      <!-- Rings front -->
      <g transform="rotate(-14 500 500)">
        <g clip-path="url(#satFront)" fill="none">
          <ellipse cx="500" cy="500" rx="720" ry="144" stroke="#EB3323" stroke-width="4" pathLength="1" stroke-dasharray=".22 .03 .4 .03 .25 .07" class="ring-red"/>
          <ellipse cx="500" cy="500" rx="670" ry="132" stroke="#F3C623" stroke-width="4" pathLength="1" stroke-dasharray=".35 .04 .3 .04 .27" class="ring-yellow"/>
          <ellipse cx="500" cy="500" rx="620" ry="120" stroke="#19A6A3" stroke-width="4" pathLength="1" stroke-dasharray=".5 .05 .4 .05" class="ring-teal"/>
          <ellipse cx="500" cy="500" rx="570" ry="108" stroke="#8A2E57" stroke-width="4" pathLength="1" stroke-dasharray=".6 .03 .34 .03" class="ring-plum"/>
          <ellipse cx="500" cy="500" rx="780" ry="156" stroke="#F1E3CB" stroke-width="1.5" pathLength="1" stroke-dasharray=".004 .008" opacity=".5" class="ring-cream"/>
        </g>
      </g>

      <!-- Moon front -->
      <g transform="rotate(-14 500 500)">
        <defs><clipPath id="moonFrontClip"><rect x="-400" y="500" width="1800" height="900"/></clipPath></defs>
        <g clip-path="url(#moonFrontClip)">
          <g>
            <circle cx="0" cy="0" r="26" fill="#E2D3B6"/>
            <circle cx="-8" cy="-6" r="7" fill="#9A8A6A" opacity=".7"/>
            <circle cx="9" cy="8" r="4.5" fill="#9A8A6A" opacity=".7"/>
            <circle cx="6" cy="-11" r="3" fill="#9A8A6A" opacity=".6"/>
            <circle cx="0" cy="0" r="26" fill="url(#moonShade)"/>
            <animateMotion dur="90s" begin="-20s" repeatCount="indefinite"
              path="M 1280 500 A 780 156 0 1 1 -280 500 A 780 156 0 1 1 1280 500"/>
          </g>
        </g>
      </g>
    </g>
  </svg>

  <!-- Red giant (left) -->
  <svg data-parallax="0.22" viewBox="0 0 800 800" class="planet-mars">
    <defs>
      <radialGradient id="marsBody" cx="38%" cy="34%" r="78%">
        <stop offset="0" stop-color="#FF9A6A"/>
        <stop offset=".4" stop-color="#EB3323"/>
        <stop offset=".8" stop-color="#7A1A10"/>
        <stop offset="1" stop-color="#2A0806"/>
      </radialGradient>
      <linearGradient id="marsTerm" x1="0" y1="0" x2="1" y2="0">
        <stop offset=".5" stop-color="#0B0A1E" stop-opacity="0"/>
        <stop offset="1" stop-color="#0B0A1E" stop-opacity=".85"/>
      </linearGradient>
      <clipPath id="marsClip"><circle cx="400" cy="400" r="330"/></clipPath>
    </defs>
    <circle cx="400" cy="400" r="370" fill="#EB3323" opacity=".18" class="blur-40"/>
    <circle cx="400" cy="400" r="330" fill="url(#marsBody)"/>
    <g clip-path="url(#marsClip)" transform="rotate(-8 400 400)">
      <rect x="0" y="230" width="800" height="18" fill="#FFB38A" opacity=".3"/>
      <rect x="0" y="290" width="800" height="46" fill="#A61E12" opacity=".5"/>
      <rect x="0" y="380" width="800" height="12" fill="#FFB38A" opacity=".3"/>
      <rect x="0" y="430" width="800" height="60" fill="#8A1A10" opacity=".5"/>
      <rect x="0" y="540" width="800" height="24" fill="#A61E12" opacity=".5"/>
      <rect x="0" y="600" width="800" height="10" fill="#FFB38A" opacity=".25"/>
    </g>
    <circle cx="400" cy="400" r="330" fill="url(#marsTerm)"/>
    <circle cx="400" cy="400" r="331" fill="none" stroke="#FF9A6A" stroke-width="1.5" opacity=".7"/>
  </svg>

  <!-- Neptune (right) -->
  <svg data-parallax="0.4" viewBox="0 0 700 700" class="planet-neptune">
    <defs>
      <radialGradient id="nepBody" cx="36%" cy="30%" r="80%">
        <stop offset="0" stop-color="#9FE8E4"/>
        <stop offset=".4" stop-color="#19A6A3"/>
        <stop offset=".8" stop-color="#0E4F5E"/>
        <stop offset="1" stop-color="#04182A"/>
      </radialGradient>
      <linearGradient id="nepTerm" x1="0" y1="0" x2="1" y2="0">
        <stop offset=".5" stop-color="#0B0A1E" stop-opacity="0"/>
        <stop offset="1" stop-color="#0B0A1E" stop-opacity=".85"/>
      </linearGradient>
      <clipPath id="nepClip"><circle cx="350" cy="350" r="250"/></clipPath>
    </defs>
    <circle cx="350" cy="350" r="290" fill="#19A6A3" opacity=".18" class="blur-36"/>
    <circle cx="350" cy="350" r="250" fill="url(#nepBody)"/>
    <g clip-path="url(#nepClip)" transform="rotate(-10 350 350)">
      <rect x="0" y="230" width="700" height="30" fill="#0E6A74" opacity=".5"/>
      <rect x="0" y="300" width="700" height="10" fill="#D7FFFB" opacity=".3"/>
      <rect x="0" y="360" width="700" height="48" fill="#0B4F5C" opacity=".5"/>
      <rect x="0" y="450" width="700" height="16" fill="#D7FFFB" opacity=".22"/>
    </g>
    <circle cx="350" cy="350" r="250" fill="url(#nepTerm)"/>
    <g transform="rotate(-22 350 350)">
      <ellipse cx="350" cy="350" rx="380" ry="58" fill="none" stroke="#F1E3CB" stroke-width="2.5" opacity=".8"/>
      <ellipse cx="350" cy="350" rx="410" ry="66" fill="none" stroke="#F3C623" stroke-width="1.5" opacity=".6"/>
    </g>
  </svg>

  <!-- Cratered moon (bottom left) -->
  <svg data-parallax="0.3" viewBox="0 0 600 600" class="planet-moon">
    <defs>
      <radialGradient id="moonBody" cx="36%" cy="32%" r="80%">
        <stop offset="0" stop-color="#FFE9A8"/>
        <stop offset=".5" stop-color="#F3C623"/>
        <stop offset=".85" stop-color="#9A6A14"/>
        <stop offset="1" stop-color="#3A2606"/>
      </radialGradient>
      <linearGradient id="moonTerm" x1="0" y1="0" x2="1" y2="0">
        <stop offset=".5" stop-color="#0B0A1E" stop-opacity="0"/>
        <stop offset="1" stop-color="#0B0A1E" stop-opacity=".85"/>
      </linearGradient>
    </defs>
    <circle cx="300" cy="300" r="260" fill="#F3C623" opacity=".16" class="blur-34"/>
    <circle cx="300" cy="300" r="220" fill="url(#moonBody)"/>
    <g fill="#8A5A10" opacity=".45">
      <circle cx="230" cy="220" r="34"/><circle cx="340" cy="170" r="16"/><circle cx="380" cy="330" r="44"/>
      <circle cx="250" cy="380" r="20"/><circle cx="170" cy="320" r="12"/><circle cx="310" cy="440" r="14"/>
    </g>
    <g fill="none" stroke="#FFE9A8" stroke-width="2" opacity=".5">
      <circle cx="230" cy="220" r="34"/><circle cx="380" cy="330" r="44"/><circle cx="250" cy="380" r="20"/>
    </g>
    <circle cx="300" cy="300" r="220" fill="url(#moonTerm)"/>
  </svg>

  <!-- Small distant bodies -->
  <svg data-parallax="0.5" viewBox="0 0 200 200" class="small-body-1">
    <circle cx="100" cy="100" r="60" fill="#F3C623" opacity=".3" class="blur-10"/>
    <circle cx="100" cy="100" r="36" fill="#FFF1B8"/>
  </svg>
  <svg data-parallax="0.55" viewBox="0 0 200 200" class="small-body-2">
    <circle cx="100" cy="100" r="50" fill="#541B36"/>
    <circle cx="100" cy="100" r="50" fill="none" stroke="#C26A8E" stroke-width="2"/>
  </svg>
</div>

<style>
.space-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: clip;
  background:
    radial-gradient(ellipse 80% 40% at 80% 6%, #1F1448 0%, rgba(11,10,30,0) 60%),
    radial-gradient(ellipse 60% 30% at 10% 40%, #2A0D1C 0%, rgba(11,10,30,0) 60%),
    radial-gradient(ellipse 70% 30% at 85% 70%, #0E2E3A 0%, rgba(11,10,30,0) 60%),
    #0B0A1E;
}

.stars-layer {
  position: absolute;
  inset: -10% 0;
  width: 100%;
  height: 120%;
}

.planet-saturn {
  position: absolute;
  left: max(64vw, calc(100% - 900px));
  top: clamp(-180px, -8vw, -60px);
  width: min(90vw, 1300px);
  height: auto;
  overflow: hidden;
}

.planet-mars {
  position: absolute;
  left: max(-26vw, -380px);
  top: 22%;
  width: min(64vw, 900px);
  height: auto;
  overflow: visible;
}

.planet-neptune {
  position: absolute;
  right: -10vw;
  top: 52%;
  width: min(46vw, 640px);
  height: auto;
  overflow: visible;
}

.planet-moon {
  position: absolute;
  left: -8vw;
  top: 84%;
  width: min(40vw, 560px);
  height: auto;
  overflow: visible;
}

.small-body-1 {
  position: absolute;
  left: 10vw;
  top: 12%;
  width: 120px;
  height: 120px;
  overflow: visible;
}

.small-body-2 {
  position: absolute;
  right: 14vw;
  top: 40%;
  width: 90px;
  height: 90px;
  overflow: visible;
}

/* SVG filter helpers */
.blur-10 { filter: blur(10px); }
.blur-34 { filter: blur(34px); }
.blur-36 { filter: blur(36px); }
.blur-40 { filter: blur(40px); }
.blur-44 { filter: blur(44px); }

.ring-red   { filter: drop-shadow(0 0 8px #EB3323); animation: ringflow 48s linear infinite; }
.ring-yellow { filter: drop-shadow(0 0 8px #F3C623); animation: ringflowrev 64s linear infinite; }
.ring-teal  { filter: drop-shadow(0 0 8px #19A6A3); animation: ringflow 36s linear infinite; }
.ring-plum  { filter: drop-shadow(0 0 8px #8A2E57); animation: ringflowrev 80s linear infinite; }
.ring-cream { animation: ringflow 120s linear infinite; }
</style>

<script>
// Generate stars procedurally
function rng(seed: number) {
  let s = seed;
  return () => { s = (s * 16807) % 2147483647; return s / 2147483647; };
}

function makeStar(cx: number, cy: number, r: number, fill: string, opacity: number, blinkDur?: string) {
  const ns = 'http://www.w3.org/2000/svg';
  const c = document.createElementNS(ns, 'circle');
  c.setAttribute('cx', cx.toFixed(2));
  c.setAttribute('cy', cy.toFixed(2));
  c.setAttribute('r', r.toFixed(3));
  c.setAttribute('fill', fill);
  c.setAttribute('opacity', opacity.toFixed(2));
  if (blinkDur) c.style.animation = `blink ${blinkDur}s ease-in-out 0s infinite`;
  return c;
}

function generateStars() {
  const farGroup = document.getElementById('stars-far');
  const nearGroup = document.getElementById('stars-near');
  if (!farGroup || !nearGroup) return;

  const rf = rng(7);
  for (let i = 0; i < 420; i++) {
    const fill = i % 7 === 0 ? '#F3C623' : '#F1E3CB';
    const opacity = 0.35 + rf() * 0.65;
    const blink = i % 3 === 0 ? (2 + rf() * 4).toFixed(1) : undefined;
    farGroup.appendChild(makeStar(rf() * 100, rf() * 1400, 0.08 + rf() * 0.12, fill, opacity, blink));
  }

  const rn = rng(21);
  for (let i = 0; i < 160; i++) {
    const fill = i % 7 === 0 ? '#F3C623' : '#FFFFFF';
    const opacity = 0.35 + rn() * 0.65;
    const blink = i % 3 === 0 ? (2 + rn() * 4).toFixed(1) : undefined;
    nearGroup.appendChild(makeStar(rn() * 100, rn() * 1400, 0.08 + rn() * 0.22, fill, opacity, blink));
  }
}

document.addEventListener('astro:page-load', generateStars);
</script>
