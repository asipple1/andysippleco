---
import Layout from '../layouts/Layout.astro';
import { timeline } from '../data/timeline';
---

<Layout title="About · Andy Sipple">
  <section class="relative z-1 bg-space/75">
    <div class="section-inner grid gap-[clamp(40px,6vw,96px)] items-start"
      style="grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr))">

      <div class="grid gap-7">
        <div class="font-mono text-[13px] tracking-[.2em] uppercase text-teal-text">About</div>
        <h1 class="m-0 font-heading font-black uppercase leading-[.88]" style="font-size:clamp(52px,8vw,128px)">Crew<br>manifest.</h1>
        <p class="m-0 text-[17px] leading-[1.6] max-w-[60ch] text-cream">I'm Andy Sipple, a full-stack developer and longtime technical lead based on Oʻahu. I like solving complicated problems without making the solution complicated.</p>
        <p class="m-0 text-[17px] leading-[1.6] max-w-[60ch] text-cream">For more than a decade I've built digital experiences for museums, airports, research institutes and media companies, mostly on Drupal, and more recently on Astro and headless stacks. I care most about the places where development meets design, accessibility and performance.</p>
        <p class="m-0 text-[17px] leading-[1.6] max-w-[60ch] text-cream">Today I work directly with Hawaiʻi businesses and with agency teams on the mainland. When I'm not building for the web, I'm somewhere outside.</p>
        <a href="/contact" class="btn btn-teal justify-self-start">Work with me</a>
      </div>

      <!-- Portrait placeholder -->
      <div data-reveal="" class="relative max-w-110 w-full justify-self-center">
        <div class="absolute inset-0 border border-yellow" style="transform:translate(16px,16px);box-shadow:0 0 18px rgba(243,198,35,.5)"></div>
        <div class="img-placeholder relative aspect-4/5 flex items-end p-4">
          <span class="font-mono text-[11px] tracking-[.14em] uppercase text-cream bg-space px-2 py-1 border border-cream/30">Portrait · Andy, natural light, unstyled</span>
        </div>
      </div>
    </div>

    <!-- Timeline -->
    <div class="max-w-7xl mx-auto px-[clamp(20px,5vw,64px)] pb-[clamp(72px,9vw,128px)] grid gap-10">
      <div class="flex justify-between items-baseline gap-6 flex-wrap border-t border-cream/18 pt-10">
        <div class="font-mono text-[13px] tracking-[.2em] uppercase text-teal-text">Flight log · Timeline</div>
        <div class="font-mono text-[11px] tracking-[.14em] uppercase text-buff">2012 → now</div>
      </div>
      <ol class="m-0 p-0 list-none grid gap-0">
        {timeline.map(t => (
          <li data-reveal="" class="grid gap-4 gap-x-8 py-6 border-b border-cream/[.14]"
            style="grid-template-columns:120px minmax(0,1fr)">
            <span class="font-mono text-[13px] tracking-[.14em]" style={`color:${t.accent}`}>{t.years}</span>
            <span class="grid gap-1.5">
              <span class="font-heading font-extrabold text-[30px] leading-[.95] uppercase">{t.title}</span>
              <span class="text-[15px] leading-[1.55] text-cream max-w-[60ch]">{t.desc}</span>
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Layout>
