---
import Layout from '../../layouts/Layout.astro';
import { notes } from '../../data/notes';
---

<Layout title="Field Notes · Andy Sipple">
  <section class="relative z-1 bg-space/75">
    <div class="section-inner grid gap-[clamp(40px,6vw,80px)]">

      <div class="grid gap-4.5">
        <div class="font-mono text-[13px] tracking-[.2em] uppercase text-teal-text">Field Notes</div>
        <h1 class="m-0 font-heading font-black uppercase leading-[.88]" style="font-size:clamp(52px,8vw,128px)">Notes from<br>the field.</h1>
        <p class="m-0 text-[17px] leading-[1.6] max-w-[60ch] text-cream">Short write-ups on things I ran into while building: performance, Drupal, Astro, and running a practice from an island.</p>
      </div>

      <div class="grid gap-0 border-t border-cream/18">
        {notes.map((n) => (
          <a href={`/notes/${n.slug}`} data-reveal=""
            class="grid gap-4 gap-x-8 items-baseline py-7 border-b border-cream/18 no-underline text-cream hover:text-yellow"
            style="grid-template-columns:minmax(0,1fr) auto">
            <span class="grid gap-2.5">
              <span class="font-mono text-[12px] tracking-[.18em] uppercase text-teal-text">{n.date} · {n.tag}</span>
              <span class="font-heading font-extrabold uppercase leading-[.95]" style="font-size:clamp(32px,4vw,56px)">{n.title}</span>
              <span class="text-[16px] leading-[1.55] text-cream max-w-[60ch]">{n.excerpt}</span>
            </span>
            <span class="font-mono text-[12px] tracking-[.14em] text-yellow">{n.read}</span>
          </a>
        ))}
      </div>

    </div>
  </section>
</Layout>
