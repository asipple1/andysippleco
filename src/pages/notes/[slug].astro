---
import Layout from '../../layouts/Layout.astro';
import { notes } from '../../data/notes';

export function getStaticPaths() {
  return notes.map(n => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const ni = notes.findIndex(n => n.slug === slug);
const post = notes[ni];
const nextPost = notes[(ni + 1) % notes.length];
---

<Layout title={`${post.title} · Andy Sipple`}>
  <section class="relative z-1 bg-space/75">
    <div class="section-inner--narrow grid gap-10">

      <a href="/notes" class="link-teal justify-self-start">← Field Notes</a>

      <div class="grid gap-5">
        <div class="font-mono text-[12px] tracking-[.18em] uppercase text-teal-text">{post.date} · {post.tag} · {post.read}</div>
        <h1 class="m-0 font-heading font-black uppercase leading-[.88]" style="font-size:clamp(44px,7vw,104px)">{post.title}</h1>
      </div>

      <div class="grid gap-5.5 text-[18px] leading-[1.7] text-cream">
        {post.body.map(para => <p class="m-0">{para}</p>)}
      </div>

      <div class="border-t border-cream/18 pt-7 flex flex-wrap justify-between gap-4 font-mono text-[12px] tracking-[.14em] uppercase">
        <span class="text-buff">Filed from Oʻahu</span>
        <a href={`/notes/${nextPost.slug}`} class="text-yellow no-underline hover:text-cream">
          Next · {nextPost.title} →
        </a>
      </div>

    </div>
  </section>
</Layout>
