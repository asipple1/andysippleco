---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
---

<Layout title="Work · Andy Sipple">
  <section class="relative z-1 bg-space/75">
    <div class="section-inner grid gap-[clamp(40px,6vw,80px)]">

      <div class="grid gap-4.5">
        <div class="font-mono text-[13px] tracking-[.2em] uppercase text-teal-text">Work · Mission log</div>
        <h1 class="m-0 font-heading font-black uppercase leading-[.88]" style="font-size:clamp(52px,8vw,128px)">Every<br>mission.</h1>
        <p class="m-0 text-[17px] leading-[1.6] max-w-[60ch] text-cream">Museums, airports, research institutes and media networks. Most of this was agency work on a team; my role on each is noted.</p>
      </div>

      <div class="grid gap-[clamp(24px,3vw,40px)]" style="grid-template-columns:repeat(auto-fill,minmax(min(100%,340px),1fr))">
        {projects.map(p => (
          <a href={`/work/${p.slug}`} data-reveal=""
            class="grid gap-4.5 no-underline text-cream relative hover:text-yellow">
            <span class="relative block">
              <span class="img-offset-frame" style={`--accent:${p.accent};transform:translate(12px,12px)`}></span>
              <span class="img-placeholder relative flex items-end aspect-4/3 p-3.5">
                <span class="font-mono text-[11px] tracking-[.14em] uppercase text-cream bg-space px-2 py-1 border border-cream/30">{p.imgLabel}</span>
              </span>
            </span>
            <span class="grid gap-2 pt-1.5">
              <span class="flex justify-between gap-4 font-mono text-[12px] tracking-[.18em] uppercase text-teal-text">
                <span>{p.num} · {p.year}</span>
                <span style={`color:${p.accent}`}>{p.role}</span>
              </span>
              <span class="font-heading font-extrabold uppercase leading-[.95]" style="font-size:clamp(32px,3.4vw,44px)">{p.name}</span>
              <span class="text-[15px] leading-[1.55] text-cream">{p.stack}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
