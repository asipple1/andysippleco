---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map(p => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const pi = projects.findIndex(p => p.slug === slug);
const proj = projects[pi];
const nextProj = projects[(pi + 1) % projects.length];
---

<Layout title={`${proj.name} · Andy Sipple`}>
  <section class="relative z-1 bg-space/75">
    <div class="section-inner grid gap-[clamp(40px,5vw,72px)]">

      <a href="/work" class="link-teal justify-self-start">← All missions</a>

      <div class="grid gap-6">
        <div class="flex gap-2.5 items-center font-mono text-[12px] tracking-[.18em] uppercase text-teal-text">
          <span class="accent-dot" style={`--accent:${proj.accent}`}></span>
          Mission {proj.num} · {proj.kind}
        </div>
        <h1 class="m-0 font-heading font-black uppercase leading-[.88]" style="font-size:clamp(56px,10vw,160px)">{proj.name}</h1>
        <div class="text-[18px] font-semibold text-yellow">{proj.client}</div>
        <p class="m-0 leading-[1.6] max-w-[56ch] text-cream" style="font-size:clamp(18px,1.5vw,22px)">{proj.desc}</p>
        <dl class="m-0 grid gap-4 gap-x-12 text-[15px]"
          style="grid-template-columns:repeat(auto-fit,minmax(140px,max-content))">
          <div>
            <dt class="font-mono text-[12px] tracking-[.18em] uppercase text-teal-text mb-1.5">Role</dt>
            <dd class="m-0 font-medium">{proj.role}</dd>
          </div>
          <div>
            <dt class="font-mono text-[12px] tracking-[.18em] uppercase text-teal-text mb-1.5">Stack</dt>
            <dd class="m-0 font-medium">{proj.stack}</dd>
          </div>
          <div>
            <dt class="font-mono text-[12px] tracking-[.18em] uppercase text-teal-text mb-1.5">Year</dt>
            <dd class="m-0 font-medium">{proj.year}</dd>
          </div>
        </dl>
      </div>

      <!-- Hero image placeholder -->
      <div data-reveal="" class="relative">
        <div class="img-offset-frame" style={`--accent:${proj.accent};transform:translate(16px,16px)`}></div>
        <div class="img-placeholder relative aspect-video flex items-end p-4">
          <span class="font-mono text-[11px] tracking-[.14em] uppercase text-cream bg-space px-2 py-1 border border-cream/30">{proj.imgLabel}</span>
        </div>
      </div>

      <!-- Challenge / Approach / Outcome -->
      <div class="panel-grid" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))">
        <div data-reveal="" class="panel panel-lg">
          <div class="font-mono text-[12px] tracking-[.18em] text-teal-text">01</div>
          <h2 class="m-0 font-heading font-extrabold text-[40px] leading-[.92] uppercase">Challenge</h2>
          <p class="m-0 text-[16px] leading-[1.6] text-cream">{proj.challenge}</p>
        </div>
        <div data-reveal="" class="panel panel-lg">
          <div class="font-mono text-[12px] tracking-[.18em] text-teal-text">02</div>
          <h2 class="m-0 font-heading font-extrabold text-[40px] leading-[.92] uppercase">Approach</h2>
          <p class="m-0 text-[16px] leading-[1.6] text-cream">{proj.approach}</p>
        </div>
        <div data-reveal="" class="panel panel-lg">
          <div class="font-mono text-[12px] tracking-[.18em] text-teal-text">03</div>
          <h2 class="m-0 font-heading font-extrabold text-[40px] leading-[.92] uppercase">Outcome</h2>
          <p class="m-0 text-[16px] leading-[1.6] text-cream">{proj.outcome}</p>
        </div>
      </div>

      <!-- Next mission -->
      <a href={`/work/${nextProj.slug}`}
        class="grid gap-2.5 no-underline text-cream border-t border-cream/18 pt-8 justify-items-end text-right hover:text-yellow">
        <span class="font-mono text-[12px] tracking-[.18em] uppercase text-teal-text">Next mission</span>
        <span class="font-heading font-black uppercase leading-[.9]" style="font-size:clamp(40px,6vw,96px)">{nextProj.name} →</span>
      </a>

    </div>
  </section>
</Layout>
