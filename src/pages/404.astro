---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Lost in space · Andy Sipple">
  <section class="relative z-1 bg-space/75 min-h-[70vh] grid items-center">
    <div class="section-inner grid gap-[clamp(40px,6vw,96px)] items-center w-full"
      style="grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))">

      <div class="grid gap-6">
        <div class="flex items-center gap-2.5 font-mono text-[13px] tracking-[.2em] uppercase text-red">
          <span class="blink-dot" style="background:#EB3323;box-shadow:0 0 10px #EB3323"></span>
          <span>Error 404 · Signal lost</span>
        </div>
        <h1 class="m-0 font-heading font-black uppercase leading-[.86]" style="font-size:clamp(60px,10vw,160px)">Lost in<br>space.</h1>
        <p class="m-0 text-[17px] leading-[1.6] max-w-[50ch] text-cream">The page you're looking for may have moved, or the coordinates were never charted.</p>
        <div class="flex flex-wrap gap-3.5">
          <a href="/" class="btn btn-teal">Return to base</a>
          <a href="/work" class="btn btn-ghost">See the work</a>
        </div>
      </div>

      <!-- 404 probe SVG -->
      <div aria-hidden="true" class="relative max-w-105 w-full justify-self-center">
        <svg viewBox="0 0 400 400" class="w-full h-auto overflow-visible" fill="none">
          <circle cx="200" cy="200" r="150" stroke="rgba(241,227,203,.18)" stroke-dasharray="4 10"/>
          <circle cx="200" cy="200" r="100" stroke="rgba(241,227,203,.18)" stroke-dasharray="4 10"/>
          <circle cx="200" cy="200" r="36" fill="#E2D3B6"/>
          <circle cx="190" cy="192" r="9" fill="#9A8A6A" opacity=".7"/>
          <circle cx="212" cy="210" r="6" fill="#9A8A6A" opacity=".7"/>
          <circle cx="208" cy="186" r="4" fill="#9A8A6A" opacity=".6"/>
          <!-- Orbiting probe -->
          <g>
            <polygon points="0,-12 10,0 0,12 -10,0" fill="#F3C623"/>
            <line x1="0" y1="12" x2="0" y2="30" stroke="#F1E3CB" stroke-width="2"/>
            <circle cx="0" cy="0" r="3" fill="#0B0A1E"/>
            <animateMotion dur="14s" repeatCount="indefinite"
              path="M 350 200 A 150 150 0 1 1 50 200 A 150 150 0 1 1 350 200"/>
          </g>
          <!-- Pulsing ring -->
          <circle cx="200" cy="200" r="36" fill="none" stroke="#EB3323" stroke-width="1.5" style="animation:blink 2.4s ease-in-out infinite"/>
        </svg>
      </div>

    </div>
  </section>
</Layout>
