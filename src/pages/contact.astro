---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
---

<Layout title="Contact · Andy Sipple">
  <section id="contact" class="relative z-1 bg-space/75">

    <!-- Neon accent rules -->
    <div aria-hidden="true" class="contact-rule-yellow"></div>
    <div aria-hidden="true" class="contact-rule-teal"></div>

    <div class="section-inner relative grid gap-[clamp(40px,6vw,96px)] items-start"
      style="grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr))">

      <div data-reveal="" class="grid gap-7">
        <div class="font-mono text-[12px] tracking-[.2em] uppercase text-yellow">Contact</div>
        <h1 class="m-0 font-heading font-black uppercase leading-[.88]" style="font-size:clamp(56px,9vw,144px)">Have a project<br>in orbit?</h1>
        <p class="m-0 leading-[1.55] max-w-[42ch]" style="font-size:clamp(17px,1.3vw,20px)">Tell me what you're working on. If I can help, I'll let you know how I'd approach it.</p>
        <div class="font-mono text-[11px] tracking-[.16em] uppercase leading-loose text-cream">
          Response window · 1–2 business days<br>
          hello@andysipple.com
        </div>
      </div>

      <!-- React contact form island -->
      <ContactForm client:load />

    </div>
  </section>
</Layout>

<style>
.contact-rule-yellow {
  position: absolute;
  right: 0;
  top: 120px;
  width: 40%;
  height: 4px;
  background: #F3C623;
  box-shadow: 0 0 14px #F3C623;
}
.contact-rule-teal {
  position: absolute;
  right: 0;
  top: 134px;
  width: 28%;
  height: 2px;
  background: #19A6A3;
  box-shadow: 0 0 10px #19A6A3;
}
</style>
