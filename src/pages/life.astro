---
import Layout from '../layouts/Layout.astro';
import { life } from '../data/life';
---

<Layout title="Life · Andy Sipple">
  <section style="position:relative;z-index:1;background:rgba(11,10,30,.75)">
    <div style="max-width:1280px;margin:0 auto;padding:clamp(72px,9vw,128px) clamp(20px,5vw,64px);display:grid;gap:clamp(40px,6vw,80px)">

      <div style="display:grid;gap:18px">
        <div style="font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:.2em;text-transform:uppercase;color:#5FD3CF">Life · Off duty</div>
        <h1 style="margin:0;font-family:'Big Shoulders Display',sans-serif;font-weight:900;font-size:clamp(52px,8vw,128px);line-height:.88;text-transform:uppercase">Shore<br>leave.</h1>
        <p style="margin:0;font-size:17px;line-height:1.6;max-width:60ch;color:#F1E3CB">Photos and clips from the island when the laptop is closed. Trails, water, family, and whatever the sky is doing that evening.</p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));grid-auto-flow:dense;gap:clamp(16px,2.4vw,28px)">
        {life.map(m => (
          <figure data-reveal="" style={`margin:0;display:grid;gap:12px;grid-column:${m.span}`}>
            <div style="position:relative">
              <div aria-hidden="true" style={`position:absolute;inset:0;transform:translate(10px,10px);border:1px solid ${m.accent};box-shadow:0 0 14px ${m.accent};pointer-events:none`}></div>
              {m.kind === 'photo' ? (
                <div class="img-placeholder" style={`position:relative;aspect-ratio:${m.ratio};`}>
                  <span style="position:absolute;left:14px;bottom:14px;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#F1E3CB;background:#0B0A1E;padding:4px 8px;border:1px solid rgba(241,227,203,.3)">{m.placeholder}</span>
                </div>
              ) : (
                <div class="img-placeholder" style={`position:relative;aspect-ratio:${m.ratio};display:grid;place-items:center`}>
                  <span style="display:grid;place-items:center;width:64px;height:64px;border:2px solid #F3C623;border-radius:50%;box-shadow:0 0 18px rgba(243,198,35,.6)">
                    <svg width="22" height="24" viewBox="0 0 22 24" aria-hidden="true"><polygon points="3,2 20,12 3,22" fill="#F3C623"/></svg>
                  </span>
                  <span style="position:absolute;left:14px;bottom:14px;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#F1E3CB;background:#0B0A1E;padding:4px 8px;border:1px solid rgba(241,227,203,.3)">Video · {m.placeholder}</span>
                </div>
              )}
            </div>
            <figcaption style="display:grid;gap:4px;padding-top:4px">
              <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:#5FD3CF">{m.date} · {m.place}</span>
              <span style="font-size:15px;line-height:1.55;color:#F1E3CB">{m.caption}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div style="border-top:1px solid rgba(241,227,203,.18);padding-top:28px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.14em;text-transform:uppercase">
        <span style="color:#E2D3B6">Logged from Oʻahu</span>
        <a href="/about" style="color:#F3C623;text-decoration:none"
          onmouseover="this.style.color='#F1E3CB'"
          onmouseout="this.style.color='#F3C623'"
        >Back on duty · About →</a>
      </div>

    </div>
  </section>
</Layout>
