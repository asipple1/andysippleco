---
import Layout from '../layouts/Layout.astro';
import { life } from '../data/life';
---

<Layout title="Life · Andy Sipple">
  <section class="relative z-1 bg-space/75">
    <div class="section-inner grid gap-[clamp(40px,6vw,80px)]">

      <div class="grid gap-4.5">
        <div class="font-mono text-[13px] tracking-[.2em] uppercase text-teal-text">Life · Off duty</div>
        <h1 class="m-0 font-heading font-black uppercase leading-[.88]" style="font-size:clamp(52px,8vw,128px)">Shore<br>leave.</h1>
        <p class="m-0 text-[17px] leading-[1.6] max-w-[60ch] text-cream">Photos and clips from the island when the laptop is closed. Trails, water, family, and whatever the sky is doing that evening.</p>
      </div>

      <div class="grid gap-[clamp(16px,2.4vw,28px)]"
        style="grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));grid-auto-flow:dense">
        {life.map(m => (
          <figure data-reveal="" class="m-0 grid gap-3" style={`grid-column:${m.span}`}>
            <div class="relative">
              <div aria-hidden="true" class="img-offset-frame" style={`--accent:${m.accent};transform:translate(10px,10px)`}></div>
              {m.kind === 'photo' ? (
                <div class="img-placeholder relative" style={`aspect-ratio:${m.ratio}`}>
                  <span class="absolute left-3.5 bottom-3.5 font-mono text-[11px] tracking-[.14em] uppercase text-cream bg-space px-2 py-1 border border-cream/30">{m.placeholder}</span>
                </div>
              ) : (
                <div class="img-placeholder relative grid place-items-center" style={`aspect-ratio:${m.ratio}`}>
                  <span class="grid place-items-center w-16 h-16 border-2 border-yellow rounded-full" style="box-shadow:0 0 18px rgba(243,198,35,.6)">
                    <svg width="22" height="24" viewBox="0 0 22 24" aria-hidden="true"><polygon points="3,2 20,12 3,22" fill="#F3C623"/></svg>
                  </span>
                  <span class="absolute left-3.5 bottom-3.5 font-mono text-[11px] tracking-[.14em] uppercase text-cream bg-space px-2 py-1 border border-cream/30">Video · {m.placeholder}</span>
                </div>
              )}
            </div>
            <figcaption class="grid gap-1 pt-1">
              <span class="font-mono text-[12px] tracking-[.18em] uppercase text-teal-text">{m.date} · {m.place}</span>
              <span class="text-[15px] leading-[1.55] text-cream">{m.caption}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="border-t border-cream/18 pt-7 flex flex-wrap justify-between gap-4 font-mono text-[12px] tracking-[.14em] uppercase">
        <span class="text-buff">Logged from Oʻahu</span>
        <a href="/about" class="text-yellow no-underline hover:text-cream">Back on duty · About →</a>
      </div>

    </div>
  </section>
</Layout>
