---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
import { services, skills } from '../data/services';

const featuredProjects = projects.slice(0, 3);
---

<Layout title="Andy Sipple | Web Developer in Hawaiʻi">

  <!-- HERO -->
  <section
    id="top"
    data-hero-scrim=""
    class="hero-scrim relative z-1 min-h-[min(96vh,980px)] flex items-center"
  >
    <div data-hero-copy="" class="relative z-[2] w-full max-w-[1280px] mx-auto px-[clamp(20px,5vw,64px)] pt-[clamp(48px,6vw,96px)] pb-[clamp(120px,16vw,200px)] grid gap-9">
      <div data-reveal="" class="font-mono text-[13px] tracking-[.2em] uppercase text-teal-text flex gap-4 items-center">
        <span class="w-7 h-0.5 bg-teal" style="box-shadow:0 0 10px #19A6A3"></span>
        <span>Senior Full-Stack Web Developer · Now Boarding</span>
      </div>

      <h1 data-reveal="" data-hero-h1=""
        class="m-0 font-heading font-black uppercase text-cream leading-[.88] max-w-[min(12ch,62vw)]"
        style="font-size:clamp(60px,9.5vw,168px)">
        Building better<br>things <span class="text-yellow" style="text-shadow:0 0 30px rgba(243,198,35,.55)">for the web.</span>
      </h1>

      <p data-reveal="" class="m-0 max-w-[min(52ch,58%)] leading-[1.55] text-cream" style="font-size:clamp(17px,1.4vw,21px)">
        I'm Andy, a senior web developer based on Oʻahu, Hawaiʻi. I build fast, thoughtful websites and digital experiences for organizations big and small.
      </p>

      <div data-reveal="" class="flex flex-wrap gap-4">
        <a href="/work" class="btn btn-cream">View My Work</a>
        <a href="/contact" class="btn btn-teal-outline">Start a Project</a>
      </div>
    </div>
  </section>

  <!-- SELECTED MISSIONS -->
  <section id="work" class="relative z-1 border-t border-cream/18 bg-space/70">
    <div class="section-inner relative">

      <div data-reveal="" class="flex items-end justify-between gap-6 flex-wrap mb-[clamp(40px,6vw,80px)]">
        <div>
          <div class="font-mono text-[13px] tracking-[.2em] uppercase text-teal-text mb-[18px]">01 / Work</div>
          <h2 class="m-0 font-heading font-black uppercase leading-[.88]" style="font-size:clamp(52px,8vw,128px)">Selected<br>Missions</h2>
        </div>
        <p class="m-0 max-w-[38ch] text-[16px] leading-[1.55] text-cream">A few projects I'm proud of. Most were built with teams at agencies; independent work is marked.</p>
      </div>

      <div class="grid gap-[clamp(48px,6vw,96px)]">
        {featuredProjects.map(p => (
          <article data-reveal="" class="grid gap-[clamp(24px,4vw,56px)] items-center border-t border-cream/18 pt-[clamp(24px,3vw,40px)]"
            style="grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr))">
            <a href={`/work/${p.slug}`}
              class="relative block no-underline transition-transform duration-300 hover:-translate-x-1 hover:-translate-y-1.5"
              style={`order:${p.imgOrder}`}>
              <div class="img-offset-frame" style={`--accent:${p.accent};transform:translate(14px,14px)`}></div>
              <div class="img-placeholder relative aspect-[4/3] flex items-end p-4">
                <span class="font-mono text-[11px] tracking-[.14em] uppercase text-cream bg-space px-2 py-1 border border-cream/30">{p.imgLabel}</span>
              </div>
            </a>
            <div class="grid gap-5" style={`order:${p.textOrder}`}>
              <div class="flex gap-2.5 items-center font-mono text-[12px] tracking-[.18em] uppercase text-teal-text">
                <span class="accent-dot" style={`--accent:${p.accent}`}></span>
                {p.num} · {p.kind}
              </div>
              <h3 class="m-0 font-heading font-extrabold uppercase leading-[.92]" style="font-size:clamp(40px,4.5vw,68px)">{p.name}</h3>
              <div class="text-[14px] font-semibold text-yellow">{p.client}</div>
              <p class="m-0 text-[16px] leading-[1.6] max-w-[48ch] text-cream">{p.desc}</p>
              <dl class="m-0 grid gap-x-8 gap-y-3 justify-start text-[14px]"
                style="grid-template-columns:repeat(auto-fit,minmax(120px,max-content))">
                <div>
                  <dt class="font-mono text-[12px] tracking-[.18em] uppercase text-teal-text mb-1">Role</dt>
                  <dd class="m-0 font-medium">{p.role}</dd>
                </div>
                <div>
                  <dt class="font-mono text-[12px] tracking-[.18em] uppercase text-teal-text mb-1">Stack</dt>
                  <dd class="m-0 font-medium">{p.stack}</dd>
                </div>
                <div>
                  <dt class="font-mono text-[12px] tracking-[.18em] uppercase text-teal-text mb-1">Year</dt>
                  <dd class="m-0 font-medium">{p.year}</dd>
                </div>
              </dl>
              <a href={`/work/${p.slug}`} class="link-red">Read the mission log →</a>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-[clamp(40px,5vw,72px)] pt-8 border-t border-cream/18">
        <a href="/work" class="link-teal">All missions →</a>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="relative z-1 bg-space/82 backdrop-blur-[6px] border-t border-cream/18">
    <div class="section-inner relative grid gap-[clamp(40px,5vw,72px)]">

      <div data-reveal="" class="grid gap-8 items-end" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr))">
        <div>
          <div class="font-mono text-[12px] tracking-[.2em] uppercase text-yellow mb-[18px]">02 / Services</div>
          <h2 class="m-0 font-heading font-black uppercase leading-[.88]" style="font-size:clamp(52px,8vw,128px)">Need something<br>built?</h2>
        </div>
        <p class="m-0 leading-[1.55] max-w-[46ch]" style="font-size:clamp(17px,1.3vw,20px)">I help businesses turn complicated web problems into fast, maintainable websites that are easy to use and easy to manage.</p>
      </div>

      <div data-reveal="" class="panel-grid" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))">
        {services.map(s => (
          <div class="panel">
            <div class="font-mono text-[12px] tracking-[.18em] text-teal-text">{s.num}</div>
            <h3 class="m-0 font-heading font-extrabold text-[34px] leading-[.95] uppercase text-cream">{s.title}</h3>
            <p class="m-0 text-[15px] leading-[1.6] text-cream">{s.desc}</p>
          </div>
        ))}
      </div>

      <div class="font-mono text-[13px] tracking-[.14em] uppercase text-yellow">
        Based on Oʻahu and available for projects throughout Hawaiʻi and beyond.
      </div>
    </div>
  </section>

  <!-- HAWAIʻI -->
  <section class="relative z-1 border-t border-cream/18">
    <div class="section-inner relative grid gap-[clamp(32px,5vw,80px)] items-center"
      style="grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr))">

      <div data-reveal="" class="grid gap-7">
        <div class="font-mono text-[13px] tracking-[.2em] uppercase text-teal-text">03 / Oʻahu · Hawaiʻi</div>
        <h2 class="m-0 font-heading font-black uppercase leading-[.88]" style="font-size:clamp(52px,8vw,128px)">Building on<br>the islands.</h2>
        <p class="m-0 text-[17px] leading-[1.6] max-w-[52ch] text-cream">I'm based on Oʻahu and work with Hawaiʻi businesses that want a thoughtful, high-performing web presence without handing their project off to an anonymous offshore team.</p>
        <p class="m-0 text-[17px] leading-[1.6] max-w-[52ch] text-cream">Whether you're starting something new or have a website that's overdue for an overhaul, I can help figure out what actually needs to be built.</p>
        <a href="/contact" class="btn btn-teal justify-self-start">Tell Me About Your Project</a>
      </div>

      <!-- Earth SVG -->
      <div aria-hidden="true" data-reveal="" class="relative aspect-square max-w-140 w-full justify-self-center">
        <svg viewBox="0 0 520 520" class="w-full h-full overflow-visible">
          <defs>
            <linearGradient id="earthTerm" x1="0" y1="0" x2="1" y2="0">
              <stop offset=".55" stop-color="#0B0A1E" stop-opacity="0"/>
              <stop offset="1" stop-color="#0B0A1E" stop-opacity=".75"/>
            </linearGradient>
            <clipPath id="earthClip"><circle cx="260" cy="260" r="230"/></clipPath>
          </defs>
          <circle cx="260" cy="260" r="260" fill="#19A6A3" opacity=".18" style="filter:blur(22px)"/>
          <circle cx="260" cy="260" r="230" fill="#19A6A3"/>
          <g clip-path="url(#earthClip)">
            <g fill="none" stroke="#0B0A1E" stroke-width="1.4" opacity=".3">
              <ellipse cx="260" cy="260" rx="156" ry="230"/>
              <ellipse cx="260" cy="260" rx="78" ry="230"/>
              <line x1="260" y1="30" x2="260" y2="490"/>
              <line x1="30" y1="260" x2="490" y2="260"/>
              <path d="M46 150 Q260 100 474 150"/>
              <path d="M46 370 Q260 420 474 370"/>
            </g>
            <g fill="#5CB85C">
              <path d="M300 70 Q360 50 410 90 Q440 130 420 170 Q380 200 345 180 Q320 160 325 130 Q300 110 300 70 Z"/>
              <path d="M400 262 Q440 250 462 285 Q470 325 445 355 Q420 385 395 365 Q372 330 380 295 Q388 272 400 262 Z"/>
              <path d="M60 110 Q110 80 150 110 Q165 150 140 175 Q105 190 85 165 Q60 140 60 110 Z"/>
            </g>
            <g fill="#5CB85C">
              <circle cx="266" cy="217" r="2.4"/>
              <circle cx="276" cy="222" r="2"/>
              <circle cx="286" cy="228" r="3.2"/>
              <circle cx="296" cy="236" r="4.6"/>
            </g>
          </g>
          <circle cx="260" cy="260" r="230" fill="url(#earthTerm)"/>
          <circle cx="260" cy="260" r="230" fill="none" stroke="#F1E3CB" stroke-width="2" opacity=".55"/>
          <circle cx="296" cy="236" r="7" fill="#EB3323" style="filter:drop-shadow(0 0 10px #EB3323)"/>
          <circle cx="296" cy="236" r="20" fill="none" stroke="#EB3323" stroke-width="1.5" style="animation:blink 2.4s ease-in-out infinite"/>
          <rect x="308" y="214" width="124" height="36" fill="#0B0A1E" opacity=".85"/>
          <text x="314" y="228" font-family="IBM Plex Mono, monospace" font-size="11" letter-spacing="2" fill="#F1E3CB">OʻAHU</text>
          <text x="314" y="244" font-family="IBM Plex Mono, monospace" font-size="10" letter-spacing="1" fill="#F3C623">21.4° N · 157.9° W</text>
          <text x="20" y="510" font-family="IBM Plex Mono, monospace" font-size="10" letter-spacing="2" fill="#19A6A3">PACIFIC OCEAN · HST (UTC−10)</text>
        </svg>
      </div>
    </div>
  </section>

  <!-- ABOUT (teaser) -->
  <section id="about" class="relative z-1 border-t border-cream/18 bg-space/82 backdrop-blur-[6px]">
    <div class="section-inner grid gap-[clamp(40px,6vw,96px)] items-center"
      style="grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr))">

      <div data-reveal="" class="relative max-w-110 w-full justify-self-center">
        <svg aria-hidden="true" viewBox="0 0 440 560" class="absolute pointer-events-none overflow-visible" style="inset:-10%;width:120%;height:120%">
          <ellipse cx="220" cy="280" rx="320" ry="90" fill="none" stroke="#EB3323" stroke-width="1.5" transform="rotate(-20 220 280)" style="filter:drop-shadow(0 0 8px #EB3323)"/>
        </svg>
        <div class="absolute inset-0 border border-yellow" style="transform:translate(16px,16px);box-shadow:0 0 18px rgba(243,198,35,.5)"></div>
        <div class="img-placeholder relative aspect-[4/5] flex items-end p-4">
          <span class="font-mono text-[11px] tracking-[.14em] uppercase text-cream bg-space px-2 py-1 border border-cream/30">Portrait · Andy, natural light, unstyled</span>
        </div>
        <div aria-hidden="true" class="absolute -top-3.5 -left-3.5 w-6 h-6 border-t-2 border-l-2 border-red"></div>
        <div aria-hidden="true" class="absolute bottom-0.5 right-0.5 w-6 h-6 border-b-2 border-r-2 border-red"></div>
      </div>

      <div data-reveal="" class="grid gap-6">
        <div class="font-mono text-[13px] tracking-[.2em] uppercase text-teal-text">04 / About</div>
        <h2 class="m-0 font-heading font-black uppercase leading-[.9]" style="font-size:clamp(44px,5.5vw,88px)">Complicated problems, uncomplicated solutions.</h2>
        <p class="m-0 text-[17px] leading-[1.6] max-w-[54ch] text-cream">I'm Andy Sipple, a full-stack developer and longtime technical lead who likes solving complicated problems without making the solution complicated.</p>
        <p class="m-0 text-[17px] leading-[1.6] max-w-[54ch] text-cream">I've spent more than a decade building digital experiences for organizations ranging from local businesses to large institutions.</p>
        <a href="/about" class="link-yellow">More about me →</a>
      </div>
    </div>
  </section>

  <!-- FLIGHT LOG -->
  <section class="relative z-1 border-t border-cream/18">
    <div data-reveal="" class="section-inner grid gap-10">
      <div class="flex justify-between items-baseline gap-6 flex-wrap">
        <div class="font-mono text-[13px] tracking-[.2em] uppercase text-teal-text">05 / Flight Log</div>
        <div class="font-mono text-[11px] tracking-[.14em] uppercase text-buff">Areas of expertise · 10+ years</div>
      </div>
      <div class="grid gap-10 gap-x-12" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))">
        {skills.map(g => (
          <div class="grid gap-3.5 content-start">
            <h3 class="m-0 font-heading font-extrabold text-[40px] leading-[.9] uppercase pb-3 border-b-2"
              style={`border-color:${g.accent};box-shadow:0 10px 18px -12px ${g.accent}`}>{g.title}</h3>
            <ul class="m-0 p-0 list-none grid gap-2 text-[16px]">
              {g.items.map(item => (
                <li class="flex gap-3 items-center">
                  <span class="w-1.5 h-1.5 bg-cream rounded-full shrink-0"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative z-1 border-t border-cream/18">
    <div data-reveal="" class="section-inner flex flex-wrap items-end justify-between gap-8">
      <div class="grid gap-[18px]">
        <div class="font-mono text-[12px] tracking-[.2em] uppercase text-yellow">06 / Contact</div>
        <h2 class="m-0 font-heading font-black uppercase leading-[.88]" style="font-size:clamp(52px,8vw,128px)">Have a project<br>in orbit?</h2>
      </div>
      <a href="/contact" class="btn btn-red">Start a Project</a>
    </div>
  </section>

</Layout>

<style>
.hero-scrim {
  background: linear-gradient(90deg, rgba(11,10,30,.85) 0%, rgba(11,10,30,.6) 45%, rgba(11,10,30,0) 70%);
}
</style>
